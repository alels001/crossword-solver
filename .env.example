# Copy to .env and fill in. Never commit .env.
# --- LLM provider: fake (offline) | openai | anthropic
CWS_LLM_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Models (defaults shown)
# CWS_OPENAI_MODEL=gpt-4.1-mini
# CWS_OPENAI_VISION_MODEL=gpt-4.1
# CWS_ANTHROPIC_MODEL=claude-sonnet-5-5

# Retrieval: tfidf (offline) | embedding | hybrid
CWS_RETRIEVER=tfidf

# Guardrails
CWS_MAX_COST_USD_PER_PUZZLE=0.50
CWS_ENABLE_WEB_DICTIONARY=false

# API protection (optional): clients must send X-API-Key
# CWS_API_KEY=change-me
CWS_LOG_JSON=false
